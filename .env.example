DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/New_York
COOKIE_SECURE=0
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
POSTGRES_DB=music_league
POSTGRES_USER=music_league
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port for the website. Change this if 8080 is already taken.
HOST_PORT=8080

# Optional browser push notifications. Generate keys with:
# docker compose run --rm web python manage.py generate_vapid_keys
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:you@example.com

# Public address used for signup QR codes and Spotify's admin OAuth callback.
# For production use your HTTPS domain, e.g. https://league.example.com
PUBLIC_URL=http://127.0.0.1:8080
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/control/spotify/callback/

# Password-reset email. Set these to your SMTP provider's values in production.
# QueueUp's SMTP backend supports an optional private CA while retaining TLS verification.
EMAIL_BACKEND=league.email_backend.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Optional path inside the web container to a trusted private CA certificate.
EMAIL_CA_FILE=
DEFAULT_FROM_EMAIL=
